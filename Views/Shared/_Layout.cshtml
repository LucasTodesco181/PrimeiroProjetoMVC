<!DOCTYPE >
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PrimeiroProjetoMVC</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PrimeiroProjetoMVC.styles.css" asp-append-version="true" />
</head>
<body>
    <nav>
        <a asp-controller="Home" asp-action="Index">Inicio</a>
        <a asp-controller="Home" asp-action="Sobre">Sobre</a>
        <a asp-controller="Alunos" asp-action="Index">Alunos</a>
        <a asp-controller="Alunos" asp-action="Criar">Novo Aluno</a>
        <a asp-controller="Alunos" asp-action="Buscar">Buscar</a>
        <a asp-controller="Home" asp-action="Saudacao">Saudação</a>
    </nav>
   
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
